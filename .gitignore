# Public source allowlist. Private traces, benchmark runs, SDK copies and runtime data stay local.
/*
!/.gitignore
!/README.md
!/README.en.md
!/package.json
!/cordis.patch.yml
!/config.json
!/lib/
/lib/*
!/lib/index.js
!/lib/core.js
!/lib/observability.js
!/lib/telemetry.js
!/scripts/
/scripts/*
!/scripts/smoke.mjs
!/scripts/fixture.mjs
!/scripts/acceptance.mjs
!/scripts/repair-fixture.mjs
!/scripts/recovery-path.mjs
!/scripts/verify-repair-evidence.mjs
!/test/
/test/*
!/test/core.test.mjs
!/test/index.test.mjs
!/test/checkpoint-wire.test.mjs
!/test/io-lifecycle.test.mjs
!/test/kernel.test.mjs
!/test/net-budget.test.mjs
!/test/projection-safety.test.mjs
!/test/recovery-path.test.mjs
!/test/telemetry.test.mjs
!/test/fixture.mjs
!/test/plugin-fixture.mjs
!/test/installed-io.mjs
!/test/restart-worker.mjs
!/test/fixtures/
/test/fixtures/*
!/test/fixtures/smoke2-checkpoint.json
!/docs/
/docs/*
!/docs/assets/
/docs/assets/*
!/docs/assets/hero.svg
!/docs/assets/workflow.zh-CN.svg
!/docs/assets/workflow.en.svg
